#!/bin/bash

# EveryCli Wrapper - Intelligent client for the EveryCli daemon
# Version: 1.2.0

PORT=51821
HOST="127.0.0.1"
DAEMON_BIN="everycli-daemon"

# Check if jq is installed
HAS_JQ=$(command -v jq)

function usage() {
    echo "EveryCli - Command Line Interface"
    echo ""
    echo "Usage:"
    echo "  everycli <query>          Search for a command"
    echo "  everycli search <query>   Search for a command"
    echo "  everycli daemon <cmd>     Manage daemon (start/stop/status/logs)"
    echo "  everycli add              Add a new scenario"
    echo "  everycli list             List all scenarios"
    echo ""
}

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

# Detect if we should use the fast path (TCP) or the direct path (PyInstaller)
USE_FAST_PATH=true
ACTION="search"
QUERY=""

case "$1" in
    daemon|add|list|export|import|update|--help)
        USE_FAST_PATH=false
        ;;
    --reload)
        ACTION="reload"
        ;;
    --ping)
        ACTION="ping"
        ;;
    search)
        ACTION="search"
        shift
        QUERY="$*"
        ;;
    *)
        ACTION="search"
        QUERY="$*"
        ;;
esac

# --- DIRECT PATH (Management commands) ---
if [ "$USE_FAST_PATH" = false ]; then
    if command -v $DAEMON_BIN >/dev/null 2>&1; then
        exec $DAEMON_BIN "$@"
    else
        echo "Error: '$DAEMON_BIN' not found. Cannot execute management command."
        exit 1
    fi
fi

# --- FAST PATH (Search/Reload/Ping) ---

# Create JSON request
if [ "$ACTION" == "search" ]; then
    ESCAPED_QUERY=$(echo "$QUERY" | sed 's/"/\\"/g')
    REQUEST="{\"action\":\"search\", \"query\":\"$ESCAPED_QUERY\", \"top_k\": 5}"
elif [ "$ACTION" == "reload" ]; then
    REQUEST="{\"action\":\"reload\"}"
else
    REQUEST="{\"action\":\"ping\"}"
fi

function send_request() {
    echo "$REQUEST" | nc -w 1 $HOST $PORT 2>/dev/null
}

RESPONSE=$(send_request)

# Auto-start daemon if search fails
if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
    if command -v $DAEMON_BIN >/dev/null 2>&1; then
        echo -e "\e[2m[everycli] Starting daemon...\e[0m"
        $DAEMON_BIN --start >/dev/null 2>&1 &
        
        MAX_RETRIES=20
        COUNT=0
        while [ $COUNT -lt $MAX_RETRIES ]; do
            sleep 0.5
            RESPONSE=$(send_request)
            if [ -n "$RESPONSE" ]; then break; fi
            ((COUNT++))
        done
    fi
fi

if [ -z "$RESPONSE" ]; then
    echo "Error: Could not connect to EveryCli daemon."
    exit 1
fi

# Process response
if [ "$HAS_JQ" ]; then
    if [ "$ACTION" == "search" ]; then
        echo "$RESPONSE" | jq -r 'if .ok then .results[] | "\u001b[32m# \(.description)\u001b[0m\n\(.command)\n" else .error end'
    else
        echo "$RESPONSE" | jq .
    fi
else
    if [ "$ACTION" == "search" ]; then
        echo "$RESPONSE" | grep -oP '"description":"\K[^"]+|"command":"\K[^"]+' | sed 'N;s/\n/\n# /;s/^/# /'
    else
        echo "$RESPONSE"
    fi
fi
